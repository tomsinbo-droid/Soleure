rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function allowedManager() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager'];
    }
    match /damage_reports/{reportId}/photo {
      allow read: if allowedManager();
      allow create: if allowedManager()
        && firestore.exists(/databases/(default)/documents/damage_reports/$(reportId))
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
    function allowedStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'staff'];
    }
    match /product_images/{sku}/cover {
      allow read: if allowedStaff()
        && firestore.exists(/databases/(default)/documents/products/$(sku));
      allow create, update: if allowedManager()
        && firestore.exists(/databases/(default)/documents/products/$(sku))
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
